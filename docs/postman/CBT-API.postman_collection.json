{
  "info": {
    "name": "API CBT U-Cademy",
    "description": "Kumpulan permintaan untuk fondasi API CBT mandiri. Saat ini hanya mencakup endpoint pemeriksaan kesehatan.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Pemeriksaan kesehatan",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        },
        "description": "Mengembalikan HTTP 200 dan {\"success\":true,\"service\":\"cbt-api\"}."
      },
      "response": []
    }
  ]
}
